{
  "name": "ctf-proxy-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"cross-env CTF_PROXY_DASHBOARD=disabled CTF_PROXY_DASHBOARD_ADDR= go run ./cmd/ctf-proxy\" \"vite\"",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "start": "pnpm run build && exec ./dist/ctf-proxy",
    "clean": "rm -rf dist cmd/ctf-proxy/dashboard/dist .tokens ctf-proxy.yaml",
    "build:frontend": "tsc -b && vite build",
    "build:backend": "go build -tags production -o dist/ctf-proxy ./cmd/ctf-proxy",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e:serve": "node scripts/e2e-serve.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:lab": "go test -tags=docker ./test/lab -run TestRealWorldLab -count=1 -v",
    "test:lab:keep": "CTF_PROXY_LAB_KEEP=1 go test -tags=docker ./test/lab -run TestRealWorldLab -count=1 -v"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
